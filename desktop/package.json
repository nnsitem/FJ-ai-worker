{
  "name": "fj-ai-worker-desktop",
  "version": "0.1.0",
  "productName": "FJ AI Worker",
  "description": "FJ AI Worker — Jira tickets fixed by Claude Code, through to a GitHub pull request",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build:main": "node esbuild.mjs",
    "build:renderer": "npm --prefix ../web run build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build:main && electron .",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@github/copilot-sdk": "^1.0.28",
    "node-pty": "^1.1.0"
  }
}
