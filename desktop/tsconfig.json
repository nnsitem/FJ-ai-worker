{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@anthropic-ai/claude-agent-sdk": ["./node_modules/@anthropic-ai/claude-agent-sdk/sdk.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "../core/src/**/*.ts"]
}
